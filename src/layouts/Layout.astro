---
interface Props {
	title?: string;
	description?: string;
}

const {
	title = 'Oraz Chollaev — Frontend & Game Developer',
	description = 'Frontend developer and game developer. Projects, experiments and links.',
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="color-scheme" content="light" />
		<meta name="theme-color" content="#ffffff" />

		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="canonical" href={canonicalURL} />
		<meta name="generator" content={Astro.generator} />

		<title>{title}</title>
		<meta name="description" content={description} />
		<meta name="author" content="Oraz Chollaev" />
		<meta name="robots" content="index, follow" />
		<meta
			name="google-site-verification"
			content="QBMjjEWYYPrsNaMGgI6rEI0LijjxMfZquhQTtvBsJOI"
		/>

		<meta property="og:type" content="website" />
		<meta property="og:site_name" content="Oraz Chollaev" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonicalURL} />
		<meta property="og:locale" content="en_US" />

		<meta name="twitter:card" content="summary" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />

		<script
			type="application/ld+json"
			set:html={JSON.stringify({
				'@context': 'https://schema.org',
				'@type': 'Person',
				name: 'Oraz Chollaev',
				url: 'https://oraz-chollaev.tech',
				jobTitle: 'Frontend & Game Developer',
				sameAs: [
					'https://instagram.com/0razch',
					'https://t.me/orazch',
					'https://play.google.com/store/apps/details?id=com.orazchollaev.invictustournamentmaker',
				],
			})}
		/>
	</head>

	<body>
		<slot />
	</body>
</html>

<style is:global>
	:root {
		color-scheme: light;

		--bg: #ffffff;
		--text: #242520;
		--muted: #85867e;
		--border: #eaeae5;
		--accent: #0b7264;
		--soft: #f5f7f5;
	}

	* {
		box-sizing: border-box;
	}

	html {
		min-height: 100%;
		scroll-behavior: smooth;
	}

	body {
		margin: 0;
		min-height: 100vh;
		background: var(--bg);
		color: var(--text);
		font-family:
			-apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
		font-size: 15px;
		line-height: 1.7;
		-webkit-font-smoothing: antialiased;
		text-rendering: optimizeLegibility;
	}

	::selection {
		background: #dcece7;
		color: #174c43;
	}

	a {
		color: inherit;
	}

	:focus-visible {
		outline: 2px solid var(--accent);
		outline-offset: 4px;
	}
</style>