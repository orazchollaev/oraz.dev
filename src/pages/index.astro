---
import Layout from '../layouts/Layout.astro';

const links = [
	{
		label: 'Invictus Tournament Maker',
		href: 'https://play.google.com/store/apps/details?id=com.orazchollaev.invictustournamentmaker',
		detail: 'Google Play',
	},
	{
		label: 'GitHub',
		href: 'https://github.com/orazchollaev',
		detail: '@orazchollaev',
	},
	{
		label: 'Instagram',
		href: 'https://instagram.com/0razch',
		detail: '@0razch',
	},
	{
		label: 'Telegram',
		href: 'https://t.me/orazch',
		detail: '@orazch',
	},
];
---

<Layout>
	<main>

		<header>
			<div class="heading">
				<p class="eyebrow">
					FRONTEND & GAMES
				</p>

				<h1>Oraz <span>Chollaev</span><span class="period">.</span></h1>
			</div>

			<div class="side-note" aria-label="A little about me">
				<span class="note-line" aria-hidden="true"></span>
				<p>
					Building things<br />
					that work well.
				</p>
			</div>
		</header>

		<section class="about" aria-label="About me">
			<p>
				I'm a frontend developer who also makes games.
				Most days, you'll find me somewhere between clean interfaces,
				a new idea, and one more small improvement.
			</p>
		</section>

		<section class="work" aria-label="Selected links">
			<div class="section-heading">
				<h2>Elsewhere</h2>
				<span class="section-count">04 LINKS</span>
			</div>

			<nav>
				<ul>
					{
						links.map((link, index) => (
							<li>
								<a
									href={link.href}
									target="_blank"
									rel="noopener noreferrer"
								>
									<span class="number">
										{String(index + 1).padStart(2, '0')}
									</span>

									<span class="label">{link.label}</span>

									<span class="detail">{link.detail}</span>

									<span class="arrow" aria-hidden="true">↗</span>
								</a>
							</li>
						))
					}
				</ul>
			</nav>
		</section>

		<footer>
			<a class="domain" href="/">oraz-chollaev.tech</a>

			<div class="footer-note">
				<span class="footer-mark" aria-hidden="true">✳</span>
				<span>Made by Oraz</span>
			</div>

			<span class="year">{new Date().getFullYear()}</span>
		</footer>
	</main>
</Layout>

<style>
	main {
		width: 100%;
		max-width: 720px;
		min-height: 100vh;
		min-height: 100svh;
		margin: 0 auto;
		padding: 32px 32px 24px;
		display: flex;
		flex-direction: column;
	}

	.topline {
		display: flex;
		align-items: center;
		justify-content: space-between;
		padding-bottom: 84px;
	}

	.monogram {
		color: var(--accent);
		font-size: 1.15rem;
		font-weight: 750;
		letter-spacing: -0.08em;
	}

	.topline-note {
		color: var(--muted);
		font-size: 0.75rem;
		letter-spacing: 0.015em;
	}

	header {
		display: flex;
		align-items: flex-end;
		justify-content: space-between;
		gap: 24px;
	}

	.eyebrow {
		display: flex;
		align-items: center;
		gap: 9px;
		margin: 0 0 18px 3px;
		color: var(--muted);
		font-size: 0.68rem;
		font-weight: 600;
		letter-spacing: 0.13em;
	}

	.status-dot {
		width: 6px;
		height: 6px;
		border-radius: 50%;
		background: var(--accent);
	}

	h1 {
		margin: 0;
		font-size: clamp(2.7rem, 7.8vw, 4.15rem);
		font-weight: 560;
		letter-spacing: -0.075em;
		line-height: 1.07;
	}

	h1 span:first-child {
		color: #a2a39c;
	}

	.period {
		color: var(--accent);
	}

	.side-note {
		display: flex;
		align-items: flex-start;
		gap: 11px;
		flex: 0 0 auto;
		margin: 0 8px 7px 0;
	}

	.note-line {
		width: 1px;
		height: 34px;
		background: var(--accent);
	}

	.side-note p {
		margin: -4px 0 0;
		font-size: 0.75rem;
		line-height: 1.65;
		color: var(--muted);
	}

	.about {
		max-width: 400px;
		margin: 42px 0 0 11%;
	}

	.about p {
		margin: 0;
		font-size: 0.97rem;
		line-height: 1.9;
		color: #62635d;
	}

	.work {
		width: 92%;
		margin: 68px 0 0 auto;
	}

	.section-heading {
		display: flex;
		align-items: center;
		justify-content: space-between;
		margin-bottom: 12px;
	}

	.section-heading h2 {
		margin: 0;
		font-size: 0.86rem;
		font-weight: 600;
		letter-spacing: -0.02em;
	}

	.section-count {
		color: var(--muted);
		font-size: 0.65rem;
		letter-spacing: 0.1em;
	}

	nav ul {
		padding: 0;
		margin: 0;
		list-style: none;
		border-top: 1px solid var(--border);
	}

	nav li {
		border-bottom: 1px solid var(--border);
	}

	nav a {
		display: grid;
		grid-template-columns: 30px minmax(0, 1fr) auto 18px;
		align-items: center;
		gap: 12px;
		min-height: 58px;
		padding: 12px 5px;
		text-decoration: none;
		transition: padding 160ms ease;
	}

	.number {
		color: #a0a198;
		font-size: 0.7rem;
		font-variant-numeric: tabular-nums;
	}

	.label {
		font-size: 0.9rem;
		font-weight: 500;
		letter-spacing: -0.015em;
	}

	.detail {
		color: var(--muted);
		font-size: 0.76rem;
	}

	.arrow {
		color: #a0a198;
		font-size: 0.95rem;
		text-align: right;
		transition:
			transform 160ms ease,
			color 160ms ease;
	}

	nav a:hover {
		padding-right: 0;
		padding-left: 10px;
	}

	nav a:hover .arrow {
		color: var(--accent);
		transform: translate(2px, -2px);
	}

	nav a:hover .label {
		color: var(--accent);
	}

	footer {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 12px;
		margin-top: auto;
		padding-top: 22px;
		border-top: 1px solid var(--border);
		color: var(--muted);
		font-size: 0.72rem;
	}

	.domain {
		text-decoration: none;
	}

	.domain:hover {
		color: var(--accent);
	}

	.footer-note {
		display: flex;
		align-items: center;
		gap: 7px;
		margin-left: 20px;
	}

	.footer-mark {
		color: var(--accent);
		font-size: 0.9rem;
	}

	.year {
		font-variant-numeric: tabular-nums;
	}

	@media (min-width: 900px) {
		main {
			padding-top: 38px;
		}

		.topline {
			padding-bottom: 100px;
		}
	}

	@media (max-width: 540px) {
		main {
			padding: 26px 22px 20px;
		}

		.topline {
			padding-bottom: 76px;
		}

		.topline-note {
			font-size: 0.68rem;
		}

		header {
			align-items: flex-start;
			gap: 12px;
		}

		h1 {
			font-size: clamp(2.45rem, 9vw, 3.3rem);
		}

		.eyebrow {
			font-size: 0.61rem;
			margin-bottom: 16px;
		}

		.side-note {
			margin: 48px 0 0;
			gap: 7px;
		}

		.side-note p {
			font-size: 0.65rem;
			white-space: nowrap;
		}

		.note-line {
			height: 29px;
		}

		.about {
			max-width: 360px;
			margin: 34px 0 0 5%;
		}

		.about p {
			font-size: 0.92rem;
		}

		.work {
			width: 100%;
			margin-top: 58px;
		}

		nav a {
			grid-template-columns: 23px minmax(0, 1fr) auto 14px;
			gap: 8px;
		}

		.label {
			font-size: 0.83rem;
		}

		.detail {
			font-size: 0.69rem;
		}
	}

	@media (max-width: 380px) {
		.side-note {
			display: none;
		}

		.about {
			margin-left: 0;
		}

		.detail {
			display: none;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		nav a,
		.arrow {
			transition: none;
		}
	}
</style>