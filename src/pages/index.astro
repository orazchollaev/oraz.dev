---
import Layout from '../layouts/Layout.astro';

const links = [
	{
		label: 'my game',
		href: 'https://play.google.com/store/apps/details?id=com.orazchollaev.invictustournamentmaker',
		host: 'play.google.com',
	},
	{ label: 'instagram', href: 'https://instagram.com/0razch', host: 'instagram.com/0razch' },
	{ label: 'telegram', href: 'https://t.me/orazch', host: 't.me/orazch' },
];
---

<Layout>
	<main>
		<header>
			<div class="avatar" aria-hidden="true">o</div>
			<div>
				<h1>oraz-<span>chollaev</span></h1>
				<p class="tag">frontend developer &middot; game developer</p>
			</div>
		</header>

		<section class="about">
			<p>
				Half-time game developer, full-time frontend developer, some-time normal person — I
				like building small things that work well.
			</p>
		</section>

		<section class="links" aria-label="Links">
			<ul>
				{
					links.map((l) => (
						<li>
							<a href={l.href} target="_blank" rel="noopener noreferrer">
								<span class="label">{l.label}</span>
								<span class="host">{l.host}</span>
								<span class="arrow" aria-hidden="true">
									&rarr;
								</span>
							</a>
						</li>
					))
				}
			</ul>
		</section>

		<footer>
			<span>oraz-chollaev.tech</span>
			<span>{new Date().getFullYear()}</span>
		</footer>
	</main>
</Layout>

<style>
	main {
		max-width: 640px;
		margin: 0 auto;
		padding: clamp(24px, 6vh, 56px) 24px;
		min-height: 100dvh;
		box-sizing: border-box;
		display: flex;
		flex-direction: column;
		justify-content: center;
		gap: clamp(1.75rem, 5vh, 2.75rem);
		animation: fade 0.5s ease both;
	}

	header {
		display: flex;
		align-items: center;
		gap: 1rem;
	}

	.avatar {
		flex: none;
		width: 48px;
		height: 48px;
		border-radius: 14px;
		background: var(--accent);
		color: var(--accent-contrast);
		display: grid;
		place-items: center;
		font-weight: 700;
		font-size: 1.25rem;
	}

	h1 {
		margin: 0;
		font-size: 1.75rem;
		letter-spacing: -0.02em;
		line-height: 1.2;
	}

	h1 span {
		color: var(--muted);
	}

	.tag {
		margin: 0.2rem 0 0;
		color: var(--muted);
		font-size: 0.875rem;
	}

	.about p {
		margin: 0;
		color: var(--text);
		font-size: 1rem;
		line-height: 1.7;
	}

	.links ul {
		list-style: none;
		margin: 0;
		padding: 0;
		display: flex;
		flex-direction: column;
		gap: 0.5rem;
	}

	.links a {
		display: flex;
		align-items: center;
		gap: 0.6rem;
		padding: 0.85rem 1rem;
		border: 1px solid var(--border);
		border-radius: 12px;
		background: var(--surface);
		text-decoration: none;
		transition: border-color 0.15s ease, transform 0.15s ease, background 0.15s ease;
	}

	.links a:hover,
	.links a:focus-visible {
		border-color: var(--accent);
		transform: translateX(2px);
	}

	.links .label {
		font-weight: 600;
	}

	.links .host {
		color: var(--faint);
		font-size: 0.8125rem;
		overflow: hidden;
		text-overflow: ellipsis;
		white-space: nowrap;
	}

	.links .arrow {
		margin-left: auto;
		color: var(--faint);
		transition: transform 0.15s ease, color 0.15s ease;
	}

	.links a:hover .arrow,
	.links a:focus-visible .arrow {
		color: var(--accent);
		transform: translateX(2px);
	}

	footer {
		display: flex;
		justify-content: space-between;
		padding-top: 1rem;
		border-top: 1px solid var(--border);
		color: var(--faint);
		font-size: 0.8125rem;
	}

	@keyframes fade {
		from {
			opacity: 0;
			transform: translateY(8px);
		}
	}

	@media (max-width: 480px) {
		h1 {
			font-size: 1.5rem;
		}
		.links .host {
			display: none;
		}
	}
</style>
